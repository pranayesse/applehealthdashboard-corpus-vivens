# Copy to .env and fill in. .env is gitignored.

# Shared secret Health Auto Export must send. Anyone on your network could
# otherwise write to your health record. Generate one with:
#   openssl rand -hex 32
INGEST_TOKEN=

# 0.0.0.0 lets your phone reach the service over the LAN.
# Set 127.0.0.1 to make it reachable only from this Mac.
HOST=0.0.0.0
PORT=8080

# Where the database lives. Anything under data/ is gitignored.
DB_PATH=./data/corpus.sqlite

# Shown in the plate masthead.
SUBJECT_NAME=

# Optional. The date you stopped smoking, e.g. 2026-08-01.
# Drives the modelled tar in the lungs. Nothing measures this — leave it
# blank and the lungs simply show your real breathing and oxygen readings.
QUIT_DATE=
